# Database and application
DATABASE_URL=postgresql://postgres:password@localhost:5432/hwaseong_db
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
CORS_ORIGINS=http://localhost:5174
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# API snapshots are written here. Keep this path out of Git.
API_STAGING_DIR=data/raw/api_staging

# Official-only manual uploads. Files stay in staging until separately promoted.
MANUAL_UPLOAD_DIR=data/raw/manual_uploads
MANUAL_UPLOAD_MAX_MB=100

# data.go.kr: use the 일반 인증키(Decoding) value, not the URL-encoded key.
PUBLIC_DATA_SERVICE_KEY=
SBIZ_API_URL=https://apis.data.go.kr/B553077/api/open/sdsc2/storeListInDong
SBIZ_DIV_ID=signguCd
SBIZ_REGION_KEY=41590
SBIZ_PAGE_SIZE=1000

# LOCALDATA Open API (변동분). Hwaseong local government code is 5530000.
LOCALDATA_AUTH_KEY=
LOCALDATA_API_URL=https://www.localdata.go.kr/platform/rest/TO0/openDataApi
LOCALDATA_LOCAL_CODE=5530000
LOCALDATA_PAGE_SIZE=1000

# 경기데이터드림. Dataset-specific filters can be supplied as JSON.
GG_OPENAPI_KEY=
GG_OPENAPI_BASE_URL=https://openapi.gg.go.kr
GG_FLOW_DATASET_ID=TB25BPTPOPDAYDONGM
GG_PAGE_SIZE=1000
GG_FLOW_EXTRA_PARAMS_JSON={}

# KOSIS. Generate the table parameters in KOSIS and paste them as JSON without apiKey.
KOSIS_API_KEY=
KOSIS_API_URL=https://kosis.kr/openapi/Param/statisticsParameterData.do
KOSIS_POPULATION_PARAMS_JSON={}
